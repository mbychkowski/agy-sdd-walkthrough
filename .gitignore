# ==============================================================================
# FulfillmentHub .gitignore
# Stack: Node.js, TypeScript, Express, React, Vite, SQLite, Vitest
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Production Outputs
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.tsbuildinfo

# SQLite Database Files & WAL / Journal files
server/data/*.sqlite
server/data/*.sqlite-*
server/data/*.db
server/data/*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*

# Environment Variables & Local Secrets
.env
.env.local
.env.*.local
*.env
*.env.local

# MCP & Agent Configuration (Local credentials / configurations)
mcp_config.json
**/mcp_config.json
*.local.json

# Explicitly ensure tracked example configs are preserved
!mcp_config.example.json
!**/mcp_config.example.json
!*.example.json

# Logs & Diagnostic Outputs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
.vitest/

# Vite & Bundler Caches
.vite/
.cache/
.eslintcache
.stylelintcache

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
